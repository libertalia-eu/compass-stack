# Frappe look for the development stack (REQ-041): the development stack applies this unless branding/branding.env exists.
# Values from the Frappe UI tokens in compass.css (gray-10, white, gray-2).
BRAND_PRIMARY=#171717
BRAND_PRIMARY_TEXT=#ffffff
BRAND_BACKGROUND=#f3f3f3
# Logo on the sign-in of the development stack, relative to this file. Nextcloud logo and favicon are set by hand in its settings.
BRAND_LOGIN_LOGO=logo.svg
