# Corporate design of a customer for the sign-in of Keycloak and the look of Nextcloud (REQ-028).
# Copy to branding.env, change, run: bash branding/apply.sh   (no quotes around values)
# Unset or empty values keep the default look.
BRAND_NAME=Acme GmbH
# Buttons and accents, #rrggbb
BRAND_PRIMARY=#0b6e4f
# Text on buttons in the primary color, #rrggbb
BRAND_PRIMARY_TEXT=#ffffff
# Background of the sign-in page, #rrggbb
BRAND_BACKGROUND=#eef3f0
# Logo of Nextcloud (and of the sign-in, unless BRAND_LOGIN_LOGO is set): svg or png, path relative to this file or absolute.
# Empty: Nextcloud keeps what is set by hand in its settings.
BRAND_LOGO=
# Logo only for the sign-in (optional, default: BRAND_LOGO)
BRAND_LOGIN_LOGO=
# Favicon of Nextcloud: svg or png (empty: unchanged)
BRAND_FAVICON=
