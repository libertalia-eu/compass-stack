# The optional mailboxes of the customer (REQ-056, REQ-066), for customer/setup.sh --mail <file>.
# Every mailbox is optional: leave its ADDRESS out and the app gets none (nothing is sent or fetched for it).
# Security is none, starttls or ssl. Hosts of the development stack (mailpit, mail-mock) are refused.
# The global server: every mailbox without a server of its own uses it.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURITY=ssl

# Helpdesk: fetched by IMAP into tickets, answered by SMTP.
SUPPORT_ADDRESS=support@example.com
# The login if it differs from the address; leave empty to log in with the address.
SUPPORT_LOGIN=
SUPPORT_PASSWORD=change-me

# CRM: fetched by IMAP into leads, answered by SMTP.
SALES_ADDRESS=sales@example.com
SALES_LOGIN=
SALES_PASSWORD=change-me
# A mailbox on another server names all three values of it, for example:
# SALES_IMAP_HOST=imap.other.example
# SALES_IMAP_PORT=993
# SALES_IMAP_SECURITY=ssl

# System mails (SMTP only): the sender of Keycloak (password reset), the default outgoing mail of Frappe and Nextcloud.
NOREPLY_ADDRESS=noreply@example.com
NOREPLY_LOGIN=
NOREPLY_PASSWORD=change-me
